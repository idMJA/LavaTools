{
  "name": "lavatools",
  "version": "1.0.70",
  "type": "module",
  "description": "A collection of tools for LavaLink",
  "main": "src/index.ts",
  "author": "Kiyomi Fujiwara <kiyomi@mja.moe>",
  "license": "MIT",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "lint": "biome check ./src",
    "test": "bun test",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "format": "biome check --write --unsafe ./src",
    "update:ejs": "bun run scripts/update-ejs.ts"
  },
  "lint-staged": {
    "*.ts": [
      "bun format"
    ]
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "astring": "^1.9.0",
    "elysia": "^1.4.29",
    "jsdom": "^30.0.1",
    "ky": "^2.0.2",
    "lru-cache": "^11.5.2",
    "meriyah": "^7.3.2",
    "playwright": "^1.62.1",
    "totp-generator": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest",
    "@types/jsdom": "^30.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
